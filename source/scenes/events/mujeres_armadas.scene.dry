subtitle: What the dirty war did to the women it took
face-image: img/muertos.jpg
tags: event
view-if: banda = "" and via = "armada" and armada_entered = 1 and compas_armadas >= 1 and compa_caida = 0 and represion >= 70 and time >= 40
priority: 4
