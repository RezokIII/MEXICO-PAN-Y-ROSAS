# =====================================================================
# EL QUEMADO — the village the army burns. The caves above it.
# =====================================================================
@bat_elquemado
title: Contacto en El Quemado
new-page: true
face-image: img/anti-guerillas2.jpg
subtitle: The village that has already been punished for you once
tags: event
view-if: banda = "sierra" and f_phase = "marcha" and ej_contacto = 1 and cerco_total = 0 and col_nodo = "elquemado" and time >= bat_last + 2
