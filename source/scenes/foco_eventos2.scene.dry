    else { Q.f_hombres-=3; Q.f_bajas=(Q.f_bajas||0)+3; Q.memorial=(Q.memorial||0)+3; Q.apoyo_popular-=8; Q.estado_intel=(Q.estado_intel||0)+10; } }
  else { Q.ch_res="disp_llevar"; Q.f_comida-=6; Q.f_moral+=8; Q.disciplina=(Q.disciplina||65)+5; Q.leyenda=(Q.leyenda||0)+2; }
}
