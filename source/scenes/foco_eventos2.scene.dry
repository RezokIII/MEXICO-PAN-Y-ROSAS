  Q.f_comida+=14; Q.f_moral-=4; Q.f_cerco-=24;
  var _z=['guerrero','oaxaca','valle']; for(var _i=0;_i<_z.length;_i++){ if(Q['pres_'+_z[_i]]>2){Q['pres_'+_z[_i]]-=2;} }
