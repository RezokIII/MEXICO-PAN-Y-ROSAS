    } else if (Q.estado_agenda=='rural' && (Q.estado_doctrina=='represion'||Q.estado_doctrina=='contrainsurgencia')) {
        var _top=''; var _tv=-1; var _rz3=['guerrero','oaxaca','valle','chihuahua','jalisco','nl','tijuana'];
        for (var _tq=0;_tq<_rz3.length;_tq++){ var _zz=_rz3[_tq]; if ((Q['pres_'+_zz]||0) > _tv) { _tv=Q['pres_'+_zz]||0; _top=_zz; } }
        if (_top && _tv >= 8) {
            Q['guar_'+_top] += (Q.estado_smart?2.2:1.4);
            if (Q.estado_smart==0) { for (var _bq=0;_bq<_rz3.length;_bq++){ if ((Q['pres_'+_rz3[_bq]]||0)>=10) { Q['guar_'+_rz3[_bq]] += 0.5; } } }
        }
    } else if (Q.estado_agenda=='internacional' && Q.estado_doctrina!='tolerancia') {
        Q.legitimidad_regimen += 0.2;
    }
    if (Q.apoyo_popular>100) { Q.apoyo_popular=100; } if (Q.apoyo_popular<0) { Q.apoyo_popular=0; }
    // the women's movement, once embraced, is a permanent multiplier: turnout, campus, the colonias
    if (Q.feminismo >= 40) {
        if (Q.time % 3 == 0) { Q.fe_voto += 0.15; }
        if (Q.time % 4 == 0 && Q.sup_students < 55) { Q.sup_students += 0.5; }
        if (Q.costureras && Q.time % 4 == 0 && Q.sup_workers < 45) { Q.sup_workers += 0.4; }
    }
    if (Q.feminismo > 100) { Q.feminismo = 100; }
    if (Q.feminismo < 0) { Q.feminismo = 0; }
    // an active escisión competes for your own base until a fusion reabsorbs it
    if (Q.escision_activa == 1) { Q.sup_students -= 0.4; Q.sup_teachers -= 0.2; }
    // the regime's grip: the more threatening you become, the harder it hunts you (scales, so it actually bites)
    if (_iz >= 35) {
        var _crack = (_iz - 35) * 0.30;
        Q.represion += 2 + _crack;
        Q.expediente += 2 + _crack;
        if (Q.fe_voto >= 45) { Q.expediente += 1; }   // a believing country is the regime's nightmare
        if (_iz >= 48) { Q.represion += 2; Q.presidente_cooptacion += 1; }   // near a majority: the gloves come off
    }
    // --- the regime's grip is sticky: legitimacy self-repairs unless kept under assault ---
    // (the PRI was built to never lose; one blow is never enough)
    // a free press is the regime's one uncontrolled mirror; with Excelsior broken, the story self-heals faster
    var _legrepair = 0.5 + (Q.excelsior_caido ? 0.25 : 0);
    if (Q.legitimidad_regimen < 66) { Q.legitimidad_regimen += _legrepair; }
    // the exiles the Party sheltered keep socialism's prestige alive as the world's turns against it
    if (Q.exiliados >= 2 && Q.prestigio_socialismo < 55 && Q.time % 3 == 0) { Q.prestigio_socialismo += 1; }
    // --- belief that the vote can matter (turnout): the inverse of the PRI's grip on the process ---
    Q.fe_voto += (72 - Q.legitimidad_regimen) * 0.017;              // as the regime's grip weakens, cynicism lifts
    if (Q.alquimia_expuesta) { Q.fe_voto += 0.35; }                // proof the fraud can be documented
    Q.fe_voto += Q.red_casillas * 0.012 + Q.escandalos * 0.06;     // a watched casilla, a scandal
    if (Q.cd_formed) { Q.fe_voto += 0.4; }                          // the Corriente makes the vote feel open
    if (_iz > 25) { Q.fe_voto += 0.1; }
    Q.fe_voto -= 0.2;                                             // decades of cynicism creep back
    if (Q.fe_voto < 0) { Q.fe_voto = 0; }
    if (Q.fe_voto > 100) { Q.fe_voto = 100; }
    if (Q.inteligencia < 0) { Q.inteligencia = 0; }
    if (Q.inteligencia > 80) { Q.inteligencia = 80; }
    if (Q.huelga_prep > 0 && Q.time % 6 == 0) { Q.huelga_prep -= 1; }
    if (Q.postura_guerrilla == 1 && Q.guerrilla_meter > 0) { Q.guerrilla_meter -= 1; }
    if (Q.huelgas > 0 && Q.time % 2 == 0) { Q.huelgas -= 1; }
    if (Q.fac_ortodoxos < 15 || Q.fac_renovadores < 15 || Q.fac_nueva_izquierda < 15) { Q.unity -= 1; }
    // faction mood: the line, and marginalization, generate dissent
    Q.des_ortodoxos += (Q.ax_sovietico <= -15 ? 1 : 0) + (Q.ax_nacpop >= 15 ? 1 : 0) + (Q.fac_ortodoxos < 18 ? 1 : 0) - 1;
    Q.des_renovadores += (Q.ax_sovietico >= 10 ? 1 : 0) + (Q.ax_electoral <= -15 ? 1 : 0) + (Q.fac_renovadores < 18 ? 1 : 0) - 1;
    Q.des_nueva += (Q.ax_electoral >= 20 ? 1 : 0) + (Q.via == "institucional" ? 1 : 0) + (Q.fac_nueva_izquierda < 18 ? 1 : 0) - 1;
    var desl = ['des_ortodoxos','des_renovadores','des_nueva'];
    for (var dq of desl) { if (Q[dq] < 0) Q[dq] = 0; if (Q[dq] > 100) Q[dq] = 100; if (Q[dq] >= 50) Q.unity -= 1; }
    // reward balance: a well-tended party knits back together
    if (Q.fac_ortodoxos >= 20 && Q.fac_renovadores >= 20 && Q.fac_nueva_izquierda >= 20 && Q.des_ortodoxos < 35 && Q.des_renovadores < 35 && Q.des_nueva < 35 && Q.unity < 60) { Q.unity += 1; }
    // dues: members feed the treasury, quarterly
    if (Q.time % 3 == 0) { Q.funds += Math.min(6, Math.floor(Q.members / 5)); }
    // Moscow pays its friends, each January - independence means self-financing
    if (Q.month == 1 && Q.ax_sovietico > -10) { Q.funds += Math.floor(Q.moscow_relation / 20); }
    // a hot guerrilla temptation bleeds your youth toward the armed groups
    if (Q.guerrilla_meter >= 15) { Q.sup_students -= 1; }
    // support decays without upkeep: movements are rebuilt monthly or not at all.
    // BUT a war that is being won is its own organizer: on the armed road, visible
    // strength (presence, the corridos, the avisos) sustains the base the legal
    // Movement can no longer tend. The armed road going WELL should not bleed the left.
    var decaylist = ['sup_workers','sup_electricians','sup_teachers','sup_students','sup_peasants','sup_colonos','sup_middle'];
    var _decay = 0.03;
    if (Q.via == 'armada') {
        var _war = Q.pres_guerrero + Q.pres_valle + Q.pres_chihuahua + Q.pres_jalisco + Q.pres_nl + Q.pres_oaxaca + Q.pres_tijuana;
        if (_war >= 60) { _decay = 0.008; }
        else if (_war >= 30) { _decay = 0.018; }
        if (_war >= 60 && Q.memorial < 12) { Q.sup_peasants += 0.4; Q.sup_students += 0.3; }
        if (_war >= 45 && Q.time % 3 == 0) { Q.members += 1; }   // clandestine growth: the war recruits
    }
    for (var ds of decaylist) {
        if (Q[ds] > 25) { Q[ds] -= (Q[ds] - 25) * _decay; }
    }
    // relationships with the system decay without maintenance - and are never limitless
    if (Q.pri_reformist_rel > 25 && Q.via != "institucional") { Q.pri_reformist_rel -= 0.7; }
    if (Q.pri_reformist_rel > 70) { Q.pri_reformist_rel = 70; }
    // big organizations fray at the top
    if (Q.unity > 85) { Q.unity -= 1; }
    if (Q.month == 1) {
        var eco = {1969:[6.3,3.4],1970:[6.5,4.7],1971:[3.8,5.2],1972:[8.2,5.6],1973:[7.9,21.3],1974:[5.8,20.6],1975:[5.7,11.2],1976:[4.2,27.2],1977:[3.4,20.7],1978:[9.0,16.2],1979:[9.7,20.0],1980:[9.2,29.8],1981:[8.8,28.7],1982:[-0.6,98.8],1983:[-4.2,80.8],1984:[3.6,59.2],1985:[2.6,63.7],1986:[-3.8,105.7],1987:[1.9,159.2],1988:[1.2,51.7]};
        if (eco[Q.year]) { Q.crecimiento = eco[Q.year][0]; Q.inflacion = eco[Q.year][1]; }
        if (Q.inflacion >= 50) { Q.salario_real -= (Q.huelgas >= 25 ? 3 : 6); }
        else if (Q.inflacion >= 15 && Q.huelgas < 25) { Q.salario_real -= 3; }
        else if (Q.inflacion >= 8 && Q.huelgas < 15) { Q.salario_real -= 1; }
        else if (Q.huelgas >= 25) { Q.salario_real += 1; }
        // the climate of ideas moves with the world
        if (Q.year >= 1980) { Q.clima_neoliberal += 2; }
        if (Q.year >= 1983) { Q.clima_neoliberal += 2; }
        if (Q.year >= 1981) { Q.prestigio_socialismo -= 1; }
        if (Q.year >= 1986) { Q.prestigio_socialismo -= 2; }
        // hegemony works on the blocs: the market creed pulls the middle, socialism's fading star chills the campus
        if (Q.clima_neoliberal >= 50 && Q.sup_middle > 3) { Q.sup_middle -= 1; }
        if (Q.prestigio_socialismo < 40 && Q.sup_students > 10) { Q.sup_students -= 1; }
        if (Q.crecimiento < 4) { Q.desempleo += 1; }
        else if (Q.crecimiento > 7 && Q.desempleo > 4) { Q.desempleo -= 1; }
    }
}
var clamplist = ['sup_workers','sup_electricians','sup_teachers','sup_students','sup_peasants','sup_colonos','sup_middle','represion','expediente','unity','political_capital','fac_ortodoxos','fac_renovadores','fac_nueva_izquierda','moscow_relation','pri_politicos','pri_tecnicos','pri_aperturistas','pri_duros','charrismo','pri_reformist_rel','presidente_cooptacion','presidente_represion'];
for (var cq of clamplist) {
    if (Q[cq] < 0) { Q[cq] = 0; }
    if (Q[cq] > 100) { Q[cq] = 100; }
}
// charrismo caps worker support: the wall must be broken before the class can be won
if (Q.salario_real < 42) { Q.salario_real = 42; }
if (Q.charrismo < 35) { Q.charrismo = 35; }
var wcap = 100 - Q.charrismo * 0.7;
if (Q.sup_workers > wcap) { Q.sup_workers = wcap; }
for (var cq2 of clamplist) { Q[cq2] = Math.round(Q[cq2] * 10) / 10; }
Q.funds = Math.round(Q.funds * 10) / 10;
if (Q.funds < 0) { Q.funds = 0; }
if (Q.guerrilla_meter < 0) { Q.guerrilla_meter = 0; }
if (Q.members < 0) { Q.members = 0; }
// make sure no stat is below 0.
for (var c of Q.classes) {
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
    }
}

Q.pro_republic = Math.round(Q.pro_republic);
Q.nationalism = Math.round(Q.nationalism);
Q.socialism = Math.round(Q.socialism);

if (Q.pro_republic < 0) {
    Q.pro_republic = 0;
}
if (Q.pro_republic >= 100) {
    Q.pro_republic = 99;
}
// izquierda sympathy derives from the Movement's sector standing (idempotent)
// --- PRI base erosion: the regime's base defects as its story cracks and the party fractures ---
var leg = Q.legitimidad_regimen; if (leg > 100) leg = 100; if (leg < 0) leg = 0;
var collapse = (72 - leg) / 72;                                   // regime legitimacy loss
if (Q.cd_formed) { collapse += 0.10; }                            // the Corriente Democratica splits the base
collapse += Math.min(0.15, Q.escandalos * 0.04);                 // scandals
collapse += Math.min(0.10, Math.max(0, Q.pri_reformist_rel - 10) * 0.004); // a real reformist current
collapse += Math.min(0.08, Math.max(0, Q.pri_aperturistas - 15) * 0.004);
if (collapse < 0) { collapse = 0; }
if (collapse > 0.62) { collapse = 0.62; }
var VB = {
 obreros:       {sup: Q.sup_workers,      pri: 78, sens: 1.05, izf: 0.55, pan: 6,  ot: 7},
 campesinos:    {sup: Q.sup_peasants,     pri: 85, sens: 1.15, izf: 0.55, pan: 4,  ot: 5},
 colonos:       {sup: Q.sup_colonos,      pri: 75, sens: 1.05, izf: 0.55, pan: 8,  ot: 10},
 medias:        {sup: Q.sup_middle,       pri: 60, sens: 0.65, izf: 0.45, pan: 25, ot: 10},
 estudiantes:   {sup: Q.sup_students,     pri: 35, sens: 0.80, izf: 0.85, pan: 15, ot: 15},
 maestros:      {sup: Q.sup_teachers,     pri: 70, sens: 0.95, izf: 0.60, pan: 5,  ot: 8},
 electricistas: {sup: Q.sup_electricians, pri: 70, sens: 0.95, izf: 0.60, pan: 5,  ot: 8}
};
for (var cls in VB) {
    var v = VB[cls];
    var pen = Math.min(1, v.sup / 55);                            // how organized the left is here
    var newpri = v.pri * (1 - collapse * v.sens);
    if (newpri < 5) { newpri = 5; }
    var freed = v.pri - newpri;                                  // PRI voters shaken loose
    Q[cls + '_pri']   = newpri;
    Q[cls + '_izq']   = v.sup * v.izf + freed * (0.24 + 0.50 * pen); // the left captures the freed, more if organized
    Q[cls + '_pan']   = v.pan + freed * 0.15;
    Q[cls + '_otros'] = v.ot  + freed * (0.55 - 0.55 * pen);        // disorganized defection -> abstention/others
}

// re-calculate party support
// calculate normalized class voting for the achievements
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}
// calculate support for each of the parties
var total_support = 0; 
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) { 
            party_support += Q[c]*Q[c+'_'+party];
        } else  { 
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        } 
    }
    Q[party + '_support'] = party_support;
    total_support += party_support; 
}
// 2. normalize support (fraction)
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    Q[party+'_votes'] = Math.round(Q[party+'_normalized']*100);
    Q[party+'_votes_display'] = Math.round(Q[party+'_normalized']*100);
}


// set faction strength/dissent to 0
for (var c of Q.factions) {
    if (Q[c+'_dissent'] < 0) {
        Q[c+'_dissent'] = 0;
    } else if (Q[c+'_dissent'] >= 100) {
        Q[c+'_dissent'] = 99;
    }
    if (Q[c+'_strength'] < 0) {
        Q[c+'_strength'] = 0;
    }
}

if (Q.unemployed <= 1) {
    Q.unemployed = 1;
}

// re-calculate dissent.
var total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.neorevisionist_strength;

// normalize strength for the different factions
Q.left_strength = 100*Q.left_strength/total_strength;
Q.center_strength = 100*Q.center_strength/total_strength;
Q.labor_strength = 100*Q.labor_strength/total_strength;
Q.reformist_strength = 100*Q.reformist_strength/total_strength;
Q.neorevisionist_strength = 100*Q.neorevisionist_strength/total_strength;

var total_dissent = Q.left_strength*Q.left_dissent + Q.center_strength*Q.center_dissent + Q.labor_strength*Q.labor_dissent + Q.reformist_strength*Q.reformist_dissent + Q.neorevisionist_strength*Q.neorevisionist_dissent;


Q.dissent = 0.01*total_dissent/total_strength;
Q.dissent_percent = Q.dissent*100;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

// 1. update dates
if (Q.month_actions >= 1) {
