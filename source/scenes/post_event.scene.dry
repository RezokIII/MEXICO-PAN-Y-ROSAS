title: Post Event
new-page: true
on-arrival: {!
Q.last_advisor_action = 0;
Q.last_cabinet_action = 0;

// --- izquierda: monthly drift, clamps, sexenio clock ---
if (Q.last_drift_month === undefined) { Q.last_drift_month = Q.month; }
if (Q.month != Q.last_drift_month) {
    Q.last_drift_month = Q.month;
    if (Q.represion > Q.presidente_represion) { Q.represion -= 1; }
    else if (Q.represion < Q.presidente_represion) { Q.represion += 1; }
    if (Q.time % 4 == 0 && Q.expediente < 100) { Q.expediente += 1; }
    if (Q.month == 12 && Q.sexenio_year < 6) { Q.sexenio_year += 1; }
    if (Q.postura_guerrilla == 3 && Q.time % 3 == 0) { Q.expediente += 1; Q.represion += 1; }
    // A cohesive leadership convenes its advisors sooner — but every extra meeting leaves a trace.
    // Unity buys advisor cadence; the price is paid in the expediente (more coordination = more surveillance).
    if (Q.unity >= 60 && Q.advisor_action_timer > 0) {
        Q.advisor_action_timer -= 1;
        if (Q.time % 2 == 0) { Q.expediente += 1; }
    }
    var zonas = ['guerrero','chihuahua','valle','jalisco','nl','oaxaca','tijuana'];
    for (var z of zonas) {
        if (Q['guar_'+z] > 22) { Q['guar_'+z] -= 1; }
        if (Q['pres_'+z] > 0 && Q['guar_'+z] >= 55) { Q['pres_'+z] -= 1; }
        if (Q['pres_'+z] < 0) { Q['pres_'+z] = 0; }
        if (Q['pres_'+z] > 60) { Q['pres_'+z] = 60; }
        if (Q['guar_'+z] > 90) { Q['guar_'+z] = 90; }
    }
    if (Q.auge_armada && !Q.sw_auge) { Q.sw_auge = 1; }
    // --- the war's own clocks ---
    if (Q.via == 'armada') {
        // el Coronel's informer web grows unless cut; wounded or exposed, it grows slower
        if (Q.coronel_activo == 1) {
            var _cg = 0.8;
            if (Q.pri_posture == 'aniquilar') { _cg += 0.4; }
            if (Q.coronel_herido == 1) { _cg -= 0.6; }
            if (Q.coronel_expuesto == 1) { _cg -= 0.4; }
            Q.coronel_red += _cg;
            if (Q.coronel_red < 0) { Q.coronel_red = 0; }
            if (Q.coronel_red > 100) { Q.coronel_red = 100; }
        }
        // morale drifts toward 55; low morale bleeds presence (desertions), high recruits
        if (Q.moral_columnas > 55) { Q.moral_columnas -= 0.4; }
        else if (Q.moral_columnas < 55) { Q.moral_columnas += 0.3; }
        if (Q.moral_columnas < 35 && Q.time % 2 == 0) {
            var _zx = ['guerrero','valle','chihuahua','jalisco','nl','oaxaca','tijuana'];
            for (var _zq of _zx) { if (Q['pres_'+_zq] > 0) { Q['pres_'+_zq] -= 0.5; } }
        }
        if (Q.moral_columnas > 78 && Q.time % 3 == 0) { Q.pres_guerrero += 1; }
        // the zone feeds the war a trickle of materiel
        if (Q.sw_zona == 1 && Q.time % 4 == 0) { Q.parque += 1; }
        if (Q.parque > 30) { Q.parque = 30; }
        if (Q.parque < 0) { Q.parque = 0; }
        if (Q.moral_columnas > 100) { Q.moral_columnas = 100; }
        if (Q.moral_columnas < 0) { Q.moral_columnas = 0; }
        // --- the war's inner life drifts too: discipline, paranoia, the line ---
        // Paranoia feeds on the Colonel's reach and the comrades in his cells.
        Q.paranoia += (Q.coronel_red >= 45 ? 0.5 : 0) + (Q.presos >= 2 ? 0.4 : 0) + (Q.moral_columnas < 40 ? 0.3 : 0);
        if (Q.coronel_red < 30 && Q.presos == 0 && Q.paranoia > 0) { Q.paranoia -= 0.3; }
        // The line shapes everything: militarism (fast, spectacular, isolating) erodes the base and
        // the columns' cohesion; the mass line (slow, rooted) sustains both but wins nothing quickly.
        if (Q.linea_guerra >= 15) { Q.disciplina -= 0.3; if (Q.time % 3 == 0) { Q.sup_peasants -= 0.5; } }
        else if (Q.linea_guerra <= -15) { Q.disciplina += 0.25; }
        // A column with low morale and high fear turns on itself.
        if (Q.moral_columnas < 40) { Q.disciplina -= 0.3; }
        if (Q.paranoia >= 55) { Q.disciplina -= 0.3; }
        // Every ajusticiamiento bought silence and spent trust; the debt comes due.
        if (Q.ajusticiamientos >= 2 && Q.time % 3 == 0) { Q.disciplina -= 0.5; Q.moral_columnas -= 0.5; }
        if (Q.paranoia > 100) { Q.paranoia = 100; } if (Q.paranoia < 0) { Q.paranoia = 0; }
        if (Q.disciplina > 100) { Q.disciplina = 100; } if (Q.disciplina < 0) { Q.disciplina = 0; }
        // --- Che's water: apoyo_popular, the sea the columns swim in ---
        // Baseline entropy: fear, time, the state's patient presence. The water drains unless you work it.
        Q.apoyo_popular -= 0.45;
        var _rooted = (Q.pres_guerrero > 15 ? 1 : 0) + (Q.pres_oaxaca > 15 ? 1 : 0) + (Q.pres_valle > 15 ? 1 : 0);
        if (Q.linea_guerra <= -8) { Q.apoyo_popular += 0.4; }           // the mass line builds the sea
        if (Q.zona_gobernada == 1) { Q.apoyo_popular += 0.4; }          // governing the zone justly
        if (_rooted >= 1 && Q.moral_columnas > 50) { Q.apoyo_popular += 0.3; }
        if (Q.linea_guerra >= 12) { Q.apoyo_popular -= 0.5; }           // militarism dries the sea
        if (Q.ajusticiamientos >= 1) { Q.apoyo_popular -= 0.2 * Math.min(3, Q.ajusticiamientos); }
        var _repr = 0; var _rzs = ['guerrero','oaxaca','valle','chihuahua','jalisco'];
        for (var _ri = 0; _ri < _rzs.length; _ri++) { if (Q['guar_'+_rzs[_ri]] >= 60) { _repr++; } }  // reprisals in the villages
        if (_repr >= 1) { Q.apoyo_popular -= 0.3 * _repr; }
        if (Q.apoyo_popular > 100) { Q.apoyo_popular = 100; } if (Q.apoyo_popular < 0) { Q.apoyo_popular = 0; }
        // the sea decides whether the state finds you: the people warn you, or the people inform.
        if (Q.coronel_activo) {
            if (Q.apoyo_popular >= 55) { Q.coronel_red -= 0.4; }        // warned; the informer network decays
            else if (Q.apoyo_popular < 30) { Q.coronel_red += 0.4; }    // informed; the Colonel's map fills itself
            if (Q.coronel_red < 0) { Q.coronel_red = 0; } if (Q.coronel_red > 100) { Q.coronel_red = 100; }
        }
        // per-region column pressure (for the map dots + the encirclement check)
        var _apf = (100 - Q.apoyo_popular) / 100;   // 0 with full support .. 1 with none
        var _pzs = ['guerrero','valle','oaxaca','chihuahua','jalisco'];
        for (var _pi = 0; _pi < _pzs.length; _pi++) {
            var _z = _pzs[_pi];
            var _pr = (Q['pres_'+_z] > 0) ? Math.round(((Q['guar_'+_z]||0)*0.55 + (Q.coronel_red||0)*0.35) * (0.55 + 0.85*_apf)) : 0;
            if (_pr > 100) { _pr = 100; } if (_pr < 0) { _pr = 0; }
            Q['presion_'+_z] = _pr;
        }
        // recount living columns (the movable tokens on the map)
        Q.n_columnas = (Q.col1_zona?1:0)+(Q.col2_zona?1:0)+(Q.col3_zona?1:0)+(Q.col4_zona?1:0)+(Q.col5_zona?1:0);
        // a column posted in a region slowly builds that region's presence; a lone column in hostile ground bleeds
        for (var _ci = 1; _ci <= 5; _ci++) {
            var _cz = Q['col'+_ci+'_zona']; if (!_cz) continue;
            if ((Q['presion_'+_cz]||0) < 55 && Q.time % 2 == 0) { Q['pres_'+_cz] = (Q['pres_'+_cz]||0) + 1; }
        }
        // --- the endgame of a winning war: liberated provinces, and Washington's clock ---
        Q.provincias_liberadas = (Q.liberado_guerrero||0)+(Q.liberado_valle||0)+(Q.liberado_oaxaca||0)+(Q.liberado_chihuahua||0)+(Q.liberado_jalisco||0);
        if (Q.provincias_liberadas >= 1) {
            Q.legitimidad_regimen -= 0.4 * Q.provincias_liberadas;   // a province lost is a crack in the eternal party
            if (Q.time % 3 == 0) { Q.parque += 1; Q.apoyo_popular += 1; }  // a liberated province feeds the war
        }
        // US intervention risk: escalate too fast — many provinces, collapsing legitimacy, an existential threat next door.
        var _esc = Q.provincias_liberadas * 8 + (Q.legitimidad_regimen < 35 ? (35 - Q.legitimidad_regimen) * 0.25 : 0) + (Q.jcr >= 2 ? 5 : 0);
        if (_esc > 18) { Q.intervencion_riesgo += (Q.provincias_liberadas >= 3 ? 1.6 : 0.6); }
        else if (Q.intervencion_riesgo > 0) { Q.intervencion_riesgo -= 0.35; }   // patient consolidation cools Washington
        if (Q.intervencion_riesgo > 100) { Q.intervencion_riesgo = 100; } if (Q.intervencion_riesgo < 0) { Q.intervencion_riesgo = 0; }
    }
    // --- THE FOCO: the band's monthly life (banda = "sierra"). Meters drain; the ring breathes;
    //     hunger and low morale bleed men to desertion; an empty band is the end of the war. ---
    if (Q.banda === "sierra" && Q.f_forjado === 1) {
        Q.f_comida -= 5;                    // the column eats every month
        Q.f_parque -= 1;                    // slow attrition of materiel
        if (Q.f_moral > 50) { Q.f_moral -= 1; } else if (Q.f_moral < 50) { Q.f_moral += 1; }
        // the ring breathes: the state's intelligence tightens it; deep water loosens it
        var _tight = 2 + (Q.estado_intel||0)*0.04;
        var _loose = (Q.apoyo_popular>=55?3:(Q.apoyo_popular>=35?1:0));
        Q.f_cerco += _tight - _loose;
        // hunger and broken morale bleed the column to desertion
        if (Q.f_comida <= 0) { Q.f_comida = 0; Q.f_hombres -= 3; Q.f_moral -= 6; Q.f_bajas += 3; }
        if (Q.f_moral <= 0) { Q.f_moral = 0; Q.f_hombres -= 2; Q.f_bajas += 2; }
        if (Q.f_desgaste > 0) { Q.f_desgaste -= 0.3; }
        // clamps
        if (Q.f_comida > 100) { Q.f_comida = 100; }
        if (Q.f_parque < 0) { Q.f_parque = 0; } if (Q.f_parque > 100) { Q.f_parque = 100; }
        if (Q.f_moral > 100) { Q.f_moral = 100; } if (Q.f_moral < 0) { Q.f_moral = 0; }
        if (Q.f_cerco > 100) { Q.f_cerco = 100; } if (Q.f_cerco < 0) { Q.f_cerco = 0; }
        if (Q.f_desgaste < 0) { Q.f_desgaste = 0; }
        // the death of the foco: no fighters left → the armed road is over (reuse the annihilation route)
        if (Q.f_hombres <= 0) { Q.f_hombres = 0; Q.f_fin_foco = 1; Q.members = 0; }
    }
    // --- THE URBAN NETWORK: monthly life (banda="ciudad"). Heat cools if you go quiet; a loud,
    //     high-profile movement stays hot; the Brigada Blanca's intelligence climbs; a network
    //     rolled up to nothing is the end of the war. ---
    if (Q.banda === "ciudad" && Q.u_forjado === 1) {
        Q.u_calor -= 4;
        Q.u_calor += (Q.u_poder||0)*0.06 + (Q.estado_intel||0)*0.03;
        if (Q.apoyo_popular >= 55) { Q.u_calor -= 2; }
        if (Q.u_calor >= 60) { Q.estado_intel = (Q.estado_intel||0) + 1; Q.u_seguridad -= 1; }
        if (Q.u_calor < 0) { Q.u_calor = 0; } if (Q.u_calor > 100) { Q.u_calor = 100; }
        if (Q.u_seguridad < 0) { Q.u_seguridad = 0; } if (Q.u_seguridad > 100) { Q.u_seguridad = 100; }
        if (Q.u_poder > 100) { Q.u_poder = 100; } if (Q.u_poder < 0) { Q.u_poder = 0; }
        if (Q.u_celulas < 0) { Q.u_celulas = 0; }
        if (Q.u_celulas <= 0) { Q.u_fin = 1; Q.members = 0; }
    }
    // veterans keep the old discipline: the file grows slower wherever they run security
    if (Q.veteranos >= 2 && Q.via != 'armada') { Q.expediente -= 0.25; }
    // the legend of the descent: a war ended on your terms keeps organizing the campo for years
    if (Q.leyenda >= 1 && Q.sup_peasants < 20 + Q.leyenda * 6) { Q.sup_peasants += 0.2; }
    if (Q.via == "armada") { Q.represion += (Q.time % 2 == 0 ? 1 : 0); Q.inteligencia -= (Q.time % 4 == 0 ? 1 : 0); }
    if (Q.via == "institucional") {
        if (Q.time % 3 == 0) { Q.sup_students -= 1; Q.funds += 1; }
        // the antechambers digest their guests: absorcion is the reformist road's clock
        Q.absorcion += 0.6 + (Q.pri_reformist_rel > 40 ? 0.3 : 0);
        if (Q.huelgas >= 12) { Q.absorcion -= 0.4; }          // a movement that still bites resists digestion
        if (Q.paros_ganados >= 3) { Q.absorcion -= 0.1; }
        if (Q.escandalos >= 3) { Q.absorcion -= 0.2; }         // keeping teeth visible
    } else if (Q.absorcion > 0) { Q.absorcion -= 0.5; }
    if (Q.absorcion < 0) { Q.absorcion = 0; }
    if (Q.absorcion > 100) { Q.absorcion = 100; }
    if (Q.absorcion >= 50) { Q.fe_voto -= 0.15; }             // a tamed left makes the vote feel pointless
    // --- The PRI responds to the Movement's growth AND its momentum: co-optation first, then repression ---
    var _iz = Q.izq_votes_display || 0;
    var _momentum = _iz - (Q.izq_prev || 0);   // points gained this month
    Q.izq_prev = _iz;
    if (_iz > 12 || _momentum > 1.5) {
        // pressure rises with your level of support AND how fast you are climbing (harder now)
        var _pressure = Math.max(0, _iz - 16) * 1.25 + Math.max(0, _momentum) * 3.8;
        // INFRASTRUCTURE is what actually holds gains: regional presence + relationships + the front
        var _infra = Q.red_casillas * 0.11 + Q.colonia_saga * 1.6
                   + (Q.municipio_alcozauca + Q.municipio_juchitan) * 3
                   + Q.pri_reformist_rel * 0.16 + Q.frente_unidad * 0.05
                   + Q.pps_rel * 0.10 + Q.parm_rel * 0.10;
        var _resist = Q.unity * 0.28 + Q.political_capital * 0.30 + Math.min(15, Q.funds) * 0.10 + _infra;
        if (_pressure > _resist) {
            // grew faster than your infrastructure can hold: the PRI reabsorbs the exposed base
            var _bleed = (_pressure - _resist) * 0.16;
            Q.sup_workers -= _bleed; Q.sup_peasants -= _bleed; Q.sup_colonos -= _bleed;
            Q.sup_teachers -= _bleed; Q.sup_students -= _bleed * 0.6; Q.sup_middle -= _bleed * 0.5;
            Q.presidente_cooptacion += 1;
            if (Q.time % 2 == 0) { Q.charrismo += 1; }
            // gains with no regional roots bleed even faster — the machine walks right back in
            if (Q.red_casillas < 20 && Q.colonia_saga < 2 && Q.municipio_alcozauca == 0 && Q.municipio_juchitan == 0) {
                Q.sup_workers -= _bleed * 0.5; Q.sup_peasants -= _bleed * 0.5; Q.sup_colonos -= _bleed * 0.5;
            }
        } else if (Q.time % 3 == 0) {
            // your infrastructure held the front: politicking keeps the regime at the table
            Q.pri_reformist_rel += 1;
        }
    }
    // ===== PRI AI: each quarter Gobernación re-reads the file and sets a posture =====
    // Visible in the Política tab; gates the regime's targeted moves. The temperament
    // of the sitting president decides whether threat is answered with money or blood.
    if (Q.time % 3 == 0 || !Q.pri_posture) {
        // the war's intensity is a threat in its own right: territory it holds, the army peeling away,
        // and a countryside that shelters it. A serious insurgency forces the state off 'contener'.
        var _presT = ((Q.pres_guerrero||0)+(Q.pres_oaxaca||0)+(Q.pres_valle||0)+(Q.pres_chihuahua||0)+(Q.pres_jalisco||0)+(Q.pres_nl||0)+(Q.pres_tijuana||0)) * 0.12;
        var _warT = (Q.provincias_liberadas||0)*7 + (Q.defecciones||0)*4 + (((Q.apoyo_popular||0) >= 55) ? 6 : 0) + (((Q.coronel_red||0) >= 55) ? 3 : 0);
        var _threat = (Q.izq_votes_display || 0)
                    + Q.red_casillas * 0.15
                    + (Q.huelga_prep || 0) * 0.12
                    + Q.escandalos * 1.5
                    + (Q.izq_seats || 0) * 0.8
                    + (Q.frente_unidad || 0) * 0.05
                    + ((Q.via == 'armada') ? 14 : 0)
                    + _presT + _warT
                    + Math.max(0, 72 - Q.legitimidad_regimen) * 0.2;
        Q.pri_threat = Math.round(_threat);
        var _style = Q.presidente_cooptacion - Q.presidente_represion;
        if (Q.via == 'armada') {
            Q.pri_posture = (_threat >= 34) ? 'aniquilar' : 'contener';
        } else if (_threat < 14) {
            Q.pri_posture = 'ignorar';
        } else if (_threat >= 34) {
            Q.pri_posture = (_style >= -20) ? 'robar' : 'reprimir';
        } else {
            Q.pri_posture = (_style >= -20) ? 'cooptar' : 'vigilar';
        }
    }
    // the posture leans on you monthly
    if (Q.pri_posture == 'cooptar') { Q.charrismo += 0.4; Q.presidente_cooptacion += 0.2; }
    else if (Q.pri_posture == 'vigilar') { Q.expediente += 0.5; }
    else if (Q.pri_posture == 'reprimir') { Q.represion += 0.6; Q.expediente += 0.3; }
    else if (Q.pri_posture == 'robar') { if (Q.red_casillas > 0 && Q.time % 2 == 0) { Q.red_casillas -= 1; } Q.legitimidad_regimen += 0.3; }
    else if (Q.pri_posture == 'contener') { Q.expediente += 0.3; }
    else if (Q.pri_posture == 'aniquilar') {
        Q.represion += 0.8;
        var _zs = ['guerrero','valle','chihuahua','jalisco','nl','oaxaca','tijuana'];
        for (var _z of _zs) { if (Q['pres_'+_z] >= 10) { Q['guar_'+_z] += 1.5; } }
    }
    // ===== THE STATE ADVERSARY: a doctrine that reads you, and sharpens with U.S. advisors =====
    // (a) U.S. advisory involvement rises as you escalate visibly; quiet consolidation lets it lapse.
    var _pull = (Q.intervencion_riesgo||0)*0.05 + (Q.provincias_liberadas||0)*1.1
              + ((Q.via=='armada')?0.22:0) + ((Q.pri_posture=='aniquilar')?0.3:0)
              + ((Q.defecciones>=1)?0.4:0) + ((Q.coronel_activo&&Q.coronel_red>=55)?0.25:0);
    if (_pull > 0.45) { Q.us_asesoria += (_pull > 2.5 ? 2.5 : _pull); }
    else if ((Q.us_asesoria||0) > 0) { Q.us_asesoria -= 0.3; }
    if (Q.us_asesoria < 0) { Q.us_asesoria = 0; } if (Q.us_asesoria > 100) { Q.us_asesoria = 100; }
    Q.estado_smart = (Q.us_asesoria >= 40) ? 1 : 0;
    // (b) the state's own intelligence capacity — the mirror of the player's inteligencia.
    var _si = (Q.expediente||0)*0.22 + ((Q.coronel_activo)?14:0) + (Q.us_asesoria||0)*0.5
            - Math.max(0,((Q.apoyo_popular||0)-40))*0.3;
    if (_si < 0) { _si = 0; } if (_si > 100) { _si = 100; }
    Q.estado_intel = Math.round(_si);
    // (c) which of your vectors is sharpest — the state attacks that one.
    var _t_elec = (Q.izq_votes_display||0) + (Q.izq_seats||0)*0.8 + (Q.red_casillas||0)*0.12 + (Q.frente_unidad||0)*0.04;
    var _t_sind = (Q.huelgas||0)*0.7 + (Q.huelga_prep||0)*0.5 + (Q.paros_ganados||0)*2 + Math.max(0,(Q.sup_workers||0)-30)*0.15;
    var _t_rural = (Q.provincias_liberadas||0)*10 + ((Q.via=='armada')?8:0);
    var _rz2 = ['guerrero','oaxaca','valle','chihuahua','jalisco'];
    for (var _rq=0;_rq<_rz2.length;_rq++){ _t_rural += (Q['pres_'+_rz2[_rq]]||0)*0.35; }
    _t_rural += Math.max(0,(Q.apoyo_popular||0)-40)*0.12;
    var _t_intl = (Q.internac_armada||0)*4 + (Q.jcr||0)*3 + (Q.escandalos||0)*1.2 + (Q.solidaridad_intl||0);
    var _amax = _t_elec, _ag = 'electoral';
    if (_t_sind > _amax) { _amax = _t_sind; _ag = 'sindical'; }
    if (_t_rural > _amax) { _amax = _t_rural; _ag = 'rural'; }
    if (_t_intl > _amax) { _amax = _t_intl; _ag = 'internacional'; }
    Q.estado_agenda = _ag; Q.estado_threat = Math.round(_amax);
    // (d) the doctrine tier (display + gating), derived from the posture and the advisors.
    var _armed = (Q.via=='armada') || ((Q.postura_guerrilla||0)>=3) || ((Q.provincias_liberadas||0)>=1);
    if (Q.pri_posture=='ignorar') { Q.estado_doctrina='tolerancia'; }
    else if (Q.pri_posture=='cooptar'||Q.pri_posture=='vigilar'||Q.pri_posture=='contener') { Q.estado_doctrina='vigilancia'; }
    else if (_armed && (Q.pri_posture=='aniquilar') && (Q.estado_smart==1 || (Q.provincias_liberadas||0)>=2)) { Q.estado_doctrina='contrainsurgencia'; }
    else { Q.estado_doctrina='represion'; }
    // (e) the heart of it: BLUNT repression radicalizes the villages and FILLS your water (martyrs);
    //     ADVISED counterinsurgency is surgical — intelligence-led, and it DRAINS the water instead.
    if (Q.estado_doctrina=='represion') {
        Q.represion += 0.4; Q.expediente += 0.3;
        if (Q.via=='armada') {
            if (Q.estado_smart==0) { Q.apoyo_popular += 0.35; Q.moral_columnas += 0.1; }
            else { Q.apoyo_popular -= 0.1; }
        }
    } else if (Q.estado_doctrina=='contrainsurgencia') {
        if (Q.coronel_activo) { Q.coronel_red += Q.estado_intel/100 * 0.9; if (Q.coronel_red>100) { Q.coronel_red=100; } }
        Q.apoyo_popular -= 0.35;
        if (Q.reconcentracion_activa==1) { Q.apoyo_popular -= 0.3; }
        Q.expediente += 0.4;
    } else if (Q.estado_doctrina=='vigilancia') {
        Q.expediente += 0.4;
        if (Q.estado_smart==1) { Q.expediente += 0.3; }
    }
    // (f) the agenda decides WHERE the weight falls this month.
    if (Q.estado_agenda=='electoral' && Q.estado_doctrina!='tolerancia') {
        if ((Q.red_casillas||0) > 0 && Q.time % 2 == 0) { Q.red_casillas -= (Q.estado_smart?1.5:1); }
        Q.charrismo += 0.2;
        if (Q.estado_doctrina=='represion' || Q.estado_doctrina=='contrainsurgencia') { if (Q.time%4==0) { Q.fraude_documentado += 1; } Q.legitimidad_regimen += 0.15; }
    } else if (Q.estado_agenda=='sindical' && Q.estado_doctrina!='tolerancia') {
