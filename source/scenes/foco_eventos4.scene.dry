@ev_herido
title: El que no puede caminar
new-page: true
face-image: img/guerillacamp.webp
subtitle: The oldest arithmetic in guerrilla war
tags: event
view-if: banda = "sierra" and f_phase = "marcha" and f_bajas >= 2 and f_cerco >= 50 and time >= f_ev_last + 3
priority: 7
frequency: 65
